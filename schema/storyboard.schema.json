{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heritage-short.local/schema/storyboard.schema.json",
  "title": "HeritageShortStoryboard",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "title",
    "logline",
    "audience",
    "intent",
    "durationTargetSec",
    "aspectRatios",
    "style",
    "character",
    "music",
    "shots",
    "endCard"
  ],
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "logline": { "type": "string", "minLength": 1 },
    "audience": { "type": "string", "minLength": 1 },
    "intent": { "type": "string", "minLength": 1 },
    "durationTargetSec": { "type": "number", "minimum": 60, "maximum": 90 },
    "aspectRatios": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["9:16", "16:9"] }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": ["block", "negative"],
      "properties": {
        "block": { "type": "string", "minLength": 1 },
        "negative": { "type": "string" }
      }
    },
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "referencePrompt"],
      "properties": {
        "id": { "type": "string" },
        "description": { "type": "string" },
        "referencePrompt": { "type": "string" }
      }
    },
    "music": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caption", "durationSec", "tempoBpm", "instrumental", "cues"],
      "properties": {
        "caption": { "type": "string" },
        "durationSec": { "type": "number", "minimum": 30, "maximum": 120 },
        "tempoBpm": { "type": "integer", "minimum": 40, "maximum": 180 },
        "instrumental": { "type": "boolean" },
        "cues": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["atSec", "purpose"],
            "properties": {
              "atSec": { "type": "number", "minimum": 0 },
              "purpose": { "type": "string" }
            }
          }
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 8,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/shot" }
    },
    "endCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "durationSec"],
      "properties": {
        "text": { "type": "string" },
        "durationSec": { "type": "number", "minimum": 2, "maximum": 5 }
      }
    }
  },
  "$defs": {
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "durationSec",
        "reason",
        "imagePrompt",
        "motionPrompt",
        "narration",
        "camera"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^shot_\\d{2}$"
        },
        "durationSec": { "type": "number", "minimum": 3, "maximum": 12 },
        "reason": { "type": "string", "minLength": 1 },
        "imagePrompt": { "type": "string", "minLength": 1 },
        "motionPrompt": { "type": "string", "minLength": 1 },
        "camera": { "type": "string", "minLength": 1 },
        "seed": { "type": ["integer", "null"] },
        "fallback": {
          "type": "string",
          "enum": ["kenburns", "still"],
          "default": "kenburns"
        },
        "narration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["am", "en"],
          "properties": {
            "am": { "type": "string" },
            "en": { "type": "string" }
          }
        }
      }
    }
  }
}
