# Copy to .env and fill in. Never commit .env.

# Google AI Studio — https://aistudio.google.com/apikey
# Used for: English Gemini TTS, Lyria music (when available)
GEMINI_API_KEY=

# Music: auto = try Lyria then FFmpeg pad | lyria | ffmpeg | file
# MUSIC_SOURCE=auto
# Optional Lyria model override (default tries lyria-3.5, then pro, then clip)
# LYRIA_MODEL=lyria-3-clip-preview
# MUSIC_USE_EXISTING=1  # skip generation if score.wav/mp3 already present

# Addis AI — https://addisassistant.com/ (Amharic TTS)
# Also accepted as ADDIS_API_KEY for the official SDK
ADDIS_AI_API_KEY=
# Optional male Amharic voice id (default: am-yohanes-calm narration)
# ADDIS_VOICE_AM=am-yohanes-calm

# Cloudflare Workers AI — https://dash.cloudflare.com/
# Account ID: Workers & Pages overview, or any Workers AI request URL
# API Token: My Profile → API Tokens → Create Token
#   (Workers AI template, or Custom with Workers AI Read/Write)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional: override image model (default: FLUX.1 schnell on Workers AI)
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Pipeline behaviour
# dry-run = no paid/quota API calls; writes placeholders + logs
PIPELINE_MODE=dry-run
# language version to assemble: am | en | both
FILM_LANGUAGE=both
