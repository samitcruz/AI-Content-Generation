# Large generated media (keep folder structure via .gitkeep only)
# Films and other outputs stay local / hosted separately — never commit binaries
outputs/films/**
!outputs/films/.gitkeep
outputs/**/*.mp4
outputs/**/*.wav
outputs/**/*.mp3
outputs/**/*.png
outputs/**/*.jpg
outputs/**/*.webp
outputs/**/*.srt
!outputs/**/.gitkeep

# Cache
.cache/
pipeline/.cache/

# Python / notebooks
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Large local model clones (not used by pipeline)
tools/
tools/**/checkpoints/
tools/**/.venv/

# OS / IDE
.idea/
.vscode/
*.swp
