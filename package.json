{
  "name": "heritage-short-pipeline",
  "version": "1.0.0",
  "description": "AI Content Generation — The Heritage Short: storyboard-driven film pipeline",
  "type": "module",
  "scripts": {
    "validate": "node pipeline/validate.js",
    "narration": "node pipeline/narration.js",
    "keyframes": "node pipeline/keyframes.js",
    "shots": "node pipeline/shots.js",
    "music": "node pipeline/music.js",
    "assemble": "node pipeline/assemble.js",
    "film": "node pipeline/run.js",
    "film:am": "cross-env FILM_LANGUAGE=am node pipeline/run.js",
    "film:en": "cross-env FILM_LANGUAGE=en node pipeline/run.js",
    "smoke": "node pipeline/smoke.js",
    "showcase": "npm --prefix showcase run dev"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "dotenv": "^16.4.7",
    "cross-env": "^7.0.3"
  }
}
